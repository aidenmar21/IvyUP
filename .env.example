# Copy to .env.local for local development, and add the same keys in
# Netlify → Site configuration → Environment variables for production.

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SECRET_KEY=sb_secret_...

# Resend → API Keys (after verifying the ivyup.org domain)
RESEND_API_KEY=re_...
EMAIL_FROM="IvyUp <hello@ivyup.org>"

# Where new sign-ups, applications, and messages are announced
OWNER_NOTIFY_EMAIL=hello@ivyup.org

# The public address of the site (no trailing slash)
NEXT_PUBLIC_SITE_URL=https://ivyup.org
